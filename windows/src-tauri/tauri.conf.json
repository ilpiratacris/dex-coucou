{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goo",
  "version": "0.4.0",
  "identifier": "it.cristianocosta.goo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    },
    "windows": [
      {
        "label": "island",
        "title": "Goo",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/coucou-hook.exe": "coucou-hook.exe",
      "../../LICENSE": "licenses/LICENSE-code.txt",
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../assets/LICENSE-own.txt": "licenses/LICENSE-own.txt",
      "../assets/identity/provenance.json": "licenses/provenance.json"
    },
    "copyright": "Copyright 2026 Cristiano Costa. Includes MIT-licensed code; see bundled notices.",
    "category": "DeveloperTool",
    "shortDescription": "Morbido accompagna il tuo lavoro",
    "longDescription": "Goo porta Morbido sul desktop: un companion minimale che segue le sessioni AI, le notifiche e le attivita di lavoro.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian",
          "English",
          "French"
        ],
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
